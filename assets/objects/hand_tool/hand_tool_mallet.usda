#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    custom string catalog:assetId = "hand_tool_mallet"
    custom string catalog:className = "hand_tool"
    custom string catalog:semanticLabel = "hand_tool"

    def Cylinder "Handle"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        uniform token axis = "Z"
        double height = 1
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.18, 0.18, 0.2)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 90, 0)
        double3 xformOp:scale = (0.04, 0.04, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cylinder "Head"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        uniform token axis = "Z"
        double height = 1
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.18, 0.18, 0.2)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0.11, 0, 0)
        double3 xformOp:rotateXYZ = (90, 0, 0)
        double3 xformOp:scale = (0.12, 0.12, 0.11)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

}
