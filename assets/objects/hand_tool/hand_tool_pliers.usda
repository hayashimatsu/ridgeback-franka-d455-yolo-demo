#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    custom string catalog:assetId = "hand_tool_pliers"
    custom string catalog:className = "hand_tool"
    custom string catalog:semanticLabel = "hand_tool"

    def Cube "HandleA"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.15, 0.38, 0.72)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (-0.03, 0.025, 0)
        double3 xformOp:rotateXYZ = (0, 0, 10)
        double3 xformOp:scale = (0.18, 0.025, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "HandleB"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.15, 0.38, 0.72)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (-0.03, -0.025, 0)
        double3 xformOp:rotateXYZ = (0, 0, -10)
        double3 xformOp:scale = (0.18, 0.025, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cone "Jaw"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        uniform token axis = "Z"
        double height = 1
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.15, 0.38, 0.72)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0.09, 0, 0)
        double3 xformOp:rotateXYZ = (0, 90, 0)
        double3 xformOp:scale = (0.08, 0.07, 0.035)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

}
