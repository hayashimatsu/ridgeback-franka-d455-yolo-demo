#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    custom string catalog:assetId = "hand_tool_wrench"
    custom string catalog:className = "hand_tool"
    custom string catalog:semanticLabel = "hand_tool"

    def Cube "Shaft"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.48, 0.5, 0.54)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.2, 0.025, 0.018)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "JawA"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.48, 0.5, 0.54)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0.105, 0.024, 0)
        double3 xformOp:rotateXYZ = (0, 0, 28)
        double3 xformOp:scale = (0.065, 0.018, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "JawB"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.48, 0.5, 0.54)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0.105, -0.024, 0)
        double3 xformOp:rotateXYZ = (0, 0, -28)
        double3 xformOp:scale = (0.065, 0.018, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

}
