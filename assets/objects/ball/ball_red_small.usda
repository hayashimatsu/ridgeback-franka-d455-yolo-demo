#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    custom string catalog:assetId = "ball_red_small"
    custom string catalog:className = "ball"
    custom string catalog:semanticLabel = "ball"

    def Sphere "Body"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.12, 0.12, 0.75)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.09, 0.09, 0.09)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

}
