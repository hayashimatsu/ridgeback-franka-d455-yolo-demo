#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    custom string catalog:assetId = "mechanical_part_pulley"
    custom string catalog:className = "mechanical_part"
    custom string catalog:semanticLabel = "mechanical_part"

    def Cylinder "Outer"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        uniform token axis = "Z"
        double height = 1
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.2, 0.25, 0.3)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.14, 0.14, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cylinder "Inner"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        uniform token axis = "Z"
        double height = 1
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.2, 0.25, 0.3)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.09, 0.09, 0.08)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

}
