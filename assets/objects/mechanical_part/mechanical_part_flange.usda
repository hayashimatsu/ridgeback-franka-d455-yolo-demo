#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    custom string catalog:assetId = "mechanical_part_flange"
    custom string catalog:className = "mechanical_part"
    custom string catalog:semanticLabel = "mechanical_part"

    def Cylinder "Hub"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        uniform token axis = "Z"
        double height = 1
        double radius = 0.5
        color3f[] primvars:displayColor = [(0.38, 0.4, 0.43)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.13, 0.13, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "LugX"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.38, 0.4, 0.43)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.18, 0.045, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "LugY"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.38, 0.4, 0.43)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.045, 0.18, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

}
