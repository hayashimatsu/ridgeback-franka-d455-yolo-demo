#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    custom string catalog:assetId = "box_cube_carton"
    custom string catalog:className = "box"
    custom string catalog:semanticLabel = "box"

    def Cube "Body"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.74, 0.3, 0.25)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.19, 0.19, 0.19)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "TopBand"
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        color3f[] primvars:displayColor = [(0.74, 0.3, 0.25)]
        uniform token primvars:displayColor:interpolation = "constant"
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.0152, 0.1919, 0.1919)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

}
